{
	"name": "fabri-pix",
	"version": "3.2.3",
	"description": "Customizable React image editor component built on Fabric.js: crop, rotate, resize, filters, blur/redact, annotate with arrows, shapes, text, steps and drawing. TypeScript, touch support, export to PNG/JPEG/WebP.",
	"type": "module",
	"types": "dist/index.d.ts",
	"main": "dist/index.cjs",
	"module": "dist/index.es.js",
	"files": [
		"dist"
	],
	"sideEffects": [
		"*.css"
	],
	"author": "Vikhyat Singh",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/vikhyatsingh123/fabri-pix"
	},
	"homepage": "https://fabri-pix.vercel.app",
	"bugs": {
		"url": "https://github.com/vikhyatsingh123/fabri-pix/issues"
	},
	"keywords": [
		"react",
		"react-image-editor",
		"image-editor",
		"photo-editor",
		"image-annotation",
		"annotation",
		"annotate",
		"screenshot",
		"markup",
		"crop",
		"image-crop",
		"cropper",
		"rotate",
		"resize",
		"filters",
		"image-filters",
		"blur",
		"redact",
		"draw",
		"drawing",
		"canvas",
		"fabric.js",
		"typescript",
		"tui-image-editor",
		"image-markup",
		"editor"
	],
	"scripts": {
		"dev": "vite",
		"build": "tsc -p tsconfig.json --noEmit && vite build",
		"lint": "eslint .",
		"preview": "vite preview",
		"prepublishOnly": "yarn build"
	},
	"peerDependencies": {
		"fabric": "^6.0.0",
		"react": ">=18.0.0",
		"react-dom": ">=18.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.19.0",
		"@types/react": "^19.0.8",
		"@types/react-dom": "^19.0.3",
		"@vitejs/plugin-react": "^4.3.4",
		"eslint": "^9.19.0",
		"eslint-plugin-react-hooks": "^5.0.0",
		"eslint-plugin-react-refresh": "^0.4.18",
		"fabric": "^6.6.1",
		"globals": "^15.14.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"typescript": "~5.7.2",
		"typescript-eslint": "^8.22.0",
		"vite": "^6.1.0",
		"vite-plugin-dts": "^4.5.3"
	},
	"dependencies": {
		"emoji-picker-react": "^4.12.0"
	}
}
